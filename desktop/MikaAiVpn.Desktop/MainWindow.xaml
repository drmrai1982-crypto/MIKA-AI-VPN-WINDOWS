<Window x:Class="MikaAiVpn.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIKA AI VPN" Height="760" Width="1120"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="White" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="#263746"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="12" Background="#14251F" BorderBrush="#00FF66" BorderThickness="1">
                    <TextBlock Text="M" Foreground="{StaticResource AccentBrush}" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MIKA AI VPN" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="MIKA AI Technologies" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="WINDOWS DESKTOP" Foreground="{StaticResource BlueBrush}" FontSize="11"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <Button x:Name="LanguageButton" Content="فارسی" Padding="16,8" Background="#16232D"
                        Foreground="White" BorderBrush="#334A5B" Click="LanguageButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ConnectionTitle" Text="Secure connection" FontSize="25"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="●" Foreground="#F5B942" FontSize="22" Margin="0,26,0,8"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConnectionState" Text="VPN core not connected" Foreground="#F5B942"
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConnectionHint" Text="The native Windows tunnel engine is not yet integrated."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" Margin="0,12,0,28"/>
                    <Button x:Name="ConnectButton" Content="CONNECT" Width="220" Height="54"
                            FontSize="16" FontWeight="Bold" IsEnabled="False"
                            Background="#23313A" Foreground="#82919C" BorderBrush="#40515D"/>
                    <TextBlock Text="Connect is disabled until the real native tunnel is verified."
                               Foreground="#82919C" FontSize="11" Margin="0,14,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SESSION" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Text="Not started" FontSize="20" Margin="0,8,0,18"/>
                        <TextBlock Text="ACTIVE BACKEND" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Text="Not available" FontSize="15" Margin="0,7,0,18"/>
                        <TextBlock Text="TUN ENGINE" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Text="Not available" FontSize="15" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="NETWORK TRAFFIC" Style="{StaticResource SmallLabel}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="↓ DOWNLOAD" Foreground="{StaticResource BlueBrush}" FontSize="11"/>
                                <TextBlock Text="—" FontSize="24" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="↑ UPLOAD" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                <TextBlock Text="—" FontSize="24" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SmallLabel}"/>
                        <TextBlock x:Name="DiagnosticsText" Text="Native FFI: not loaded&#10;Wintun: not verified in this desktop session&#10;Tunnel: unavailable"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <TextBlock Text="MIKA AI Technologies" Foreground="#718394" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="Windows 10 / 11 · x64 · Development build" Foreground="#718394"
                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
