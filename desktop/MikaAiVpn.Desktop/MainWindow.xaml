<Window x:Class="MikaAiVpn.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MIKA AI VPN" Height="790" Width="1240" MinHeight="660" MinWidth="1000"
 WindowStyle="None" ResizeMode="CanResize"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
 Foreground="White" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="PanelStyle" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
   <Setter Property="BorderBrush" Value="#263746"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/>
  </Style>
  <Style x:Key="SmallLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#14232B"/>
   <Setter Property="BorderBrush" Value="#31505D"/><Setter Property="Padding" Value="14,9"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="48" Height="48" CornerRadius="13" Background="#10251F" BorderBrush="#4FE3C1" BorderThickness="1">
     <TextBlock Text="M" Foreground="#4FE3C1" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="MIKA AI VPN" FontSize="23" FontWeight="Bold"/>
     <TextBlock Text="MIKA AI Technologies" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <TextBlock Text="GLOBAL NETWORK · WINDOWS" Foreground="{StaticResource BlueBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
    <Button x:Name="LanguageButton" Content="فارسی" Click="LanguageButton_Click" Margin="0,0,12,0"/>
    <Button x:Name="MinimizeButton" Content="—" Width="38" Height="34" Padding="0" FontSize="18" Margin="3,0" ToolTip="Minimize" Click="MinimizeButton_Click"/>
    <Button x:Name="MaximizeButton" Content="□" Width="38" Height="34" Padding="0" FontSize="17" Margin="3,0" ToolTip="Maximize" Click="MaximizeButton_Click"/>
    <Button x:Name="CloseButton" Content="×" Width="38" Height="34" Padding="0" FontSize="22" Margin="3,0,0,0"
     Background="#51202A" BorderBrush="#A43A4C" Foreground="#FFF0F2" ToolTip="Close" Click="CloseButton_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2.05*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,0">
      <TextBlock x:Name="WorldTitle" Text="GLOBAL NETWORK" Foreground="#4FE3C1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="WorldSubtitle" Text="Live planet view · Night lights" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
     </StackPanel>
     <Grid Grid.Row="1" ClipToBounds="False">
      <Ellipse Width="568" Height="568" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.98">
       <Ellipse.Fill>
        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
         <GradientStop Color="#002E8BFF" Offset="0.55"/>
         <GradientStop Color="#263D9BFF" Offset="0.70"/>
         <GradientStop Color="#74439DFF" Offset="0.84"/>
         <GradientStop Color="#3A27D9FF" Offset="0.93"/>
         <GradientStop Color="#0027D9FF" Offset="1"/>
        </RadialGradientBrush>
       </Ellipse.Fill>
       <Ellipse.Effect><BlurEffect Radius="34"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="528" Height="528" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#553F9FFF" StrokeThickness="4" IsHitTestVisible="False">
       <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
      </Ellipse>
      <Viewport3D x:Name="GlobeViewport" Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False" IsHitTestVisible="False"/>
      <Canvas x:Name="RadarCanvas" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" IsHitTestVisible="False">
       <Ellipse Width="210" Height="210" Fill="#C9061424" Stroke="#8A4AA6C2" StrokeThickness="1.2"/>
       <Ellipse Canvas.Left="8" Canvas.Top="8" Width="194" Height="194" Stroke="#3950B5D8" StrokeThickness="1"/>
       <Ellipse Canvas.Left="30" Canvas.Top="30" Width="150" Height="150" Stroke="#6650B5D8" StrokeThickness="1"/>
       <Ellipse Canvas.Left="53" Canvas.Top="53" Width="104" Height="104" Stroke="#5550B5D8" StrokeThickness="1"/>
       <Ellipse Canvas.Left="76" Canvas.Top="76" Width="58" Height="58" Stroke="#4450B5D8" StrokeThickness="1"/>
       <Line X1="105" Y1="5" X2="105" Y2="205" Stroke="#334C9AB8" StrokeThickness="1"/>
       <Line X1="5" Y1="105" X2="205" Y2="105" Stroke="#334C9AB8" StrokeThickness="1"/>
       <Line X1="34" Y1="34" X2="176" Y2="176" Stroke="#223B819F" StrokeThickness="1"/>
       <Line X1="176" Y1="34" X2="34" Y2="176" Stroke="#223B819F" StrokeThickness="1"/>
       <TextBlock Canvas.Left="101" Canvas.Top="10" Text="N" Foreground="#A8CBE0" FontSize="8" FontWeight="Bold"/>
       <TextBlock Canvas.Left="193" Canvas.Top="101" Text="E" Foreground="#A8CBE0" FontSize="8" FontWeight="Bold"/>
       <TextBlock Canvas.Left="102" Canvas.Top="190" Text="S" Foreground="#A8CBE0" FontSize="8" FontWeight="Bold"/>
       <TextBlock Canvas.Left="10" Canvas.Top="101" Text="W" Foreground="#A8CBE0" FontSize="8" FontWeight="Bold"/>
      </Canvas>
      <Canvas x:Name="RadarSweepCanvas" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
       <Path Data="M 105,105 L 105,5 A 100,100 0 0 1 191,54 Z">
        <Path.Fill>
         <RadialGradientBrush Center="0.5,0.5" RadiusX="0.95" RadiusY="0.95">
          <GradientStop Color="#0050E6FF" Offset="0"/>
          <GradientStop Color="#3350E6FF" Offset="0.54"/>
          <GradientStop Color="#7950E6FF" Offset="0.84"/>
          <GradientStop Color="#0050E6FF" Offset="1"/>
         </RadialGradientBrush>
        </Path.Fill>
        <Path.Effect><BlurEffect Radius="11"/></Path.Effect>
       </Path>
       <Line X1="105" Y1="105" X2="105" Y2="7" Stroke="#8850E6FF" StrokeThickness="12" StrokeStartLineCap="Round">
        <Line.Effect><DropShadowEffect Color="#50E6FF" BlurRadius="32" ShadowDepth="0" Opacity="1"/></Line.Effect>
       </Line>
       <Line X1="105" Y1="105" X2="105" Y2="7" Stroke="#EEFFFFFF" StrokeThickness="2.1" StrokeStartLineCap="Round">
        <Line.Effect><DropShadowEffect Color="#50E6FF" BlurRadius="20" ShadowDepth="0" Opacity="1"/></Line.Effect>
       </Line>
      </Canvas>
      <Canvas x:Name="RadarNodesCanvas" Width="210" Height="210" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" IsHitTestVisible="False"/>

     </Grid>
     <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,4">
      <TextBlock x:Name="ConnectionState" Text="CORE READY · TUNNEL NOT STARTED" Foreground="#FFC46B" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="ConnectionHint" Text="The globe and radar run locally. VPN traffic is not active." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Column="2">
    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock x:Name="SessionLabel" Text="SESSION" Style="{StaticResource SmallLabel}"/>
      <TextBlock x:Name="SessionValue" Text="Not started" FontSize="20" Margin="0,7,0,16"/>
      <TextBlock x:Name="BackendLabel" Text="ACTIVE BACKEND" Style="{StaticResource SmallLabel}"/>
      <TextBlock x:Name="BackendValue" Text="Not available" FontSize="14" Margin="0,6,0,15"/>
      <TextBlock x:Name="TunLabel" Text="TUN ENGINE" Style="{StaticResource SmallLabel}"/>
      <TextBlock x:Name="TunValue" Text="Not available" FontSize="14" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock x:Name="TrafficLabel" Text="NETWORK TRAFFIC" Style="{StaticResource SmallLabel}"/>
      <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0"><TextBlock x:Name="DownloadLabel" Text="↓ DOWNLOAD" Foreground="#4FE3C1" FontSize="10"/><TextBlock Text="—" FontSize="23" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock x:Name="UploadLabel" Text="↑ UPLOAD" Foreground="#9B8CFF" FontSize="10"/><TextBlock Text="—" FontSize="23" Margin="0,4,0,0"/></StackPanel>
      </Grid>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource PanelStyle}">
     <StackPanel>
      <TextBlock x:Name="DiagnosticsLabel" Text="DIAGNOSTICS" Style="{StaticResource SmallLabel}"/>
      <Button x:Name="DiagnosticsButton" Content="Inspect core and engines" Click="DiagnosticsButton_Click" Margin="0,11,0,9" Background="#173329" Foreground="#4FE3C1" BorderBrush="#286B4B"/>
      <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
       <TextBlock x:Name="DiagnosticsText" Text="Inspection has not been run. This test does not start a tunnel." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="18"/>
      </ScrollViewer>
     </StackPanel>
    </Border>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="4">
   <TextBlock Text="MIKA AI Technologies" Foreground="#718394" FontSize="10" VerticalAlignment="Center"/>
   <TextBlock Text="Windows 10 / 11 · x64 · Development build" Foreground="#718394" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>