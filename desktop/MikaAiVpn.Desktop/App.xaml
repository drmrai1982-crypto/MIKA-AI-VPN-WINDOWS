<Application x:Class="MikaAiVpn.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="CyberBackground">#06090E</Color>
        <Color x:Key="CyberPanel">#101821</Color>
        <Color x:Key="CyberGreen">#00FF66</Color>
        <Color x:Key="CyberBlue">#00E5FF</Color>
        <Color x:Key="CyberMuted">#91A4B7</Color>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource CyberBackground}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource CyberPanel}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CyberGreen}"/>
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource CyberBlue}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource CyberMuted}"/>
    </Application.Resources>
</Application>
